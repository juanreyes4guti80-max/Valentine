-- Explosión de fuego estilo anime (impacto de la H1). Dura 1.3 s y cierra limpio.
function KaijuFireVFX.Explosion(cf: CFrame, scale: number?, shake: number?): Part
	return play(SPEC_Explosion, cf, scale, nil, shake)
end

